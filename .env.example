# Plantilla de variables de entorno — copiar a .env y rellenar.
#   cp .env.example .env
#
# .env está en .gitignore y NUNCA debe subirse al repositorio.
# Si una clave se filtra: revocarla en Binance inmediatamente, no rotarla después.

# ---------------------------------------------------------------------------
# Binance
# ---------------------------------------------------------------------------
# T1-T8 usan claves de TESTNET: https://testnet.binance.vision
# Para live (solo tras superar los criterios go/no-go de la seccion 4 del plan):
#   - Permisos: SOLO "Enable Spot & Margin Trading"
#   - Retiros: DESHABILITADOS
#   - Whitelist de IP: la IP fija del VPS
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------------------------------------------------------------------------
# Telegram (notificaciones y control remoto)
# ---------------------------------------------------------------------------
# Token: crear un bot con @BotFather
# Chat ID: escribirle al bot y consultar
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# FreqUI / API REST (localhost:8080)
# ---------------------------------------------------------------------------
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=
# Cadena aleatoria para firmar los JWT. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=
