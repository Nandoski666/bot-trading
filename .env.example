# Plantilla de variables de entorno — copiar a .env y rellenar.
#   cp .env.example .env
#
# .env está en .gitignore y NUNCA debe subirse al repositorio.
# Si una clave se filtra: revocarla en Binance inmediatamente, no rotarla después.

# ---------------------------------------------------------------------------
# Binance
# ---------------------------------------------------------------------------
# T1-T8 usan claves de TESTNET: https://testnet.binance.vision
# Para live (solo tras superar los criterios go/no-go de la seccion 4 del plan):
#   - Permisos: SOLO "Enable Spot & Margin Trading"
#   - Retiros: DESHABILITADOS
#   - Whitelist de IP: la IP fija del VPS
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---------------------------------------------------------------------------
# Telegram (notificaciones y control remoto)
# ---------------------------------------------------------------------------
# DEJAR EN false. Telegram solo admite un cliente por token haciendo
# getUpdates, y con cinco bots compartiendolo se pelean por el canal
# ('Conflict: terminated by other getUpdates'): /status lo contesta uno al
# azar y las notificaciones se pierden.
#
# Quien habla por Telegram es el vigilante (tools/watchdog.py): notifica
# los cierres de los cinco y responde /estado, /ops, /pausar y /reanudar
# por todos a la vez.
FREQTRADE__TELEGRAM__ENABLED=false

# Token: crear un bot con @BotFather (/newbot) y pegarlo aqui.
# Chat ID: lo averigua solo `python tools/setup_telegram.py` — no hace falta
# buscarlo a mano en getUpdates.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# ---------------------------------------------------------------------------
# FreqUI / API REST (localhost:8080)
# ---------------------------------------------------------------------------
FREQTRADE__API_SERVER__USERNAME=freqtrader
FREQTRADE__API_SERVER__PASSWORD=
# Cadena aleatoria para firmar los JWT. Generar con:
#   python -c "import secrets; print(secrets.token_hex(32))"
FREQTRADE__API_SERVER__JWT_SECRET_KEY=

# ---------------------------------------------------------------------------
# Filtro de contexto con IA (opcional)
# ---------------------------------------------------------------------------
# Sin esta clave el filtro no bloquea nada y el sistema opera igual que antes.
# Falla abierto a proposito: que se caiga un servicio externo no puede dejar
# las posiciones sin gestionar.
#
# Obtener en https://console.anthropic.com
ANTHROPIC_API_KEY=

# Alternativa GRATUITA a Anthropic para el filtro de contexto.
# Soporta busqueda web (modelos compound) y salida estructurada, que es todo lo
# que el filtro necesita. Con las dos claves presentes gana Anthropic.
# Obtener en https://console.groq.com/keys
GROQ_API_KEY=
